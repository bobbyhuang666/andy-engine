{
  "name": "andy-engine",
  "version": "2.0.1",
  "description": "心理学驱动的多智能体社会模拟引擎 — 让 AI 角色拥有记忆、情绪、人格和社交关系",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "golden:regen": "GOLDEN_REGEN=1 vitest run tests/unit/golden-seed-replay.test.js",
    "test:domain": "vitest run tests/domain.test.js tests/domain-deep.test.js tests/domain-contract.test.js tests/source-scan.test.js tests/fallback-minimal.test.js",
    "test:compat": "vitest run tests/compatibility.test.js tests/package-boundary.test.js",
    "release:check": "npm test && npm run test:domain && npm run check:boundaries && npm run pack:dry-run",
    "smoke:pack": "bash scripts/smoke-pack.sh",
    "benchmark": "node benchmarks/baseline.js",
    "benchmark:quick": "node benchmarks/baseline.js quick",
    "perf:check": "node benchmarks/perf-check.js",
    "perf:calibrate": "bash scripts/perf-calibrate.sh",
    "perf:diagnose": "node benchmarks/perf-check.js --diagnose",
    "profile": "node benchmarks/profile.js",
    "profile:quick": "node benchmarks/profile.js quick",
    "profile:agent": "node benchmarks/agent-tick-profile.js",
    "profile:agent:quick": "node benchmarks/agent-tick-profile.js quick",
    "profile:emotion": "node benchmarks/emotion-profile.js",
    "profile:emotion:quick": "node benchmarks/emotion-profile.js quick",
    "profile:contagion": "node benchmarks/contagion-profile.js",
    "profile:contagion:quick": "node benchmarks/contagion-profile.js quick",
    "demo": "cd demo/character-lab && npm install && node server.js",
    "pack:dry-run": "npm pack --dry-run",
    "check:boundaries": "node scripts/check-boundaries.js",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "bash scripts/consumer-typecheck.sh",
    "sqlite:smoke": "node -e \"const { SQLiteStore } = require('./src/store'); const db = new SQLiteStore(':memory:'); db.saveSnapshot(0, Date.now(), Buffer.from('test')); const s = db.loadLatest(); if (!s || s.tick !== 0) throw new Error('SQLite smoke failed'); db.close(); console.log('SQLite smoke: OK');\"",
    "fresh:consumer": "bash scripts/fresh-consumer-matrix.sh",
    "release:clean": "bash scripts/check-release-clean.sh",
    "release:gate": "bash scripts/release-gate.sh"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "agent/",
    "store/",
    "sdk/",
    "facts/",
    "domain/",
    "presets/",
    "src/",
    "native/",
    "examples/",
    "docs/DOMAIN.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "multi-agent",
    "social-simulation",
    "emotion-model",
    "cognitive-appraisal",
    "act-r",
    "agent-based-modeling",
    "personality",
    "character-engine",
    "ai-npc",
    "virtual-world",
    "domain-config"
  ],
  "author": "bobbyhuang666",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "express": "^5.2.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js"
    },
    "./sdk": {
      "types": "./sdk/index.d.ts",
      "require": "./sdk/index.js"
    },
    "./domain": "./domain/index.js",
    "./domain/validate": "./src/domain/validateDomain.js",
    "./domain/registry": "./src/domain/DomainRegistry.js",
    "./facts": "./facts/index.js",
    "./store": "./store/index.js",
    "./config/defaults": "./src/config/defaults.js",
    "./presets/campus": "./presets/campus/index.js",
    "./presets/tavern": "./presets/tavern/index.js"
  },
  "types": "index.d.ts"
}
