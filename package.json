{
  "name": "andy-engine",
  "version": "0.2.0",
  "description": "心理学驱动的多智能体社会模拟引擎 — 让 AI 角色拥有记忆、情绪、人格和社交关系",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:domain": "vitest run tests/domain.test.js tests/domain-deep.test.js tests/domain-contract.test.js tests/source-scan.test.js tests/fallback-minimal.test.js",
    "test:compat": "vitest run tests/compatibility.test.js tests/package-boundary.test.js",
    "release:check": "npm test && npm run test:domain && npm run pack:dry-run",
    "demo": "cd demo/character-lab && npm install && node server.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "files": [
    "index.js",
    "agent/",
    "core/",
    "social/",
    "spatial/",
    "store/",
    "sdk/",
    "domain/",
    "presets/",
    "config/",
    "examples/",
    "docs/DOMAIN.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "multi-agent",
    "social-simulation",
    "emotion-model",
    "cognitive-appraisal",
    "act-r",
    "agent-based-modeling",
    "personality",
    "character-engine",
    "ai-npc",
    "virtual-world",
    "domain-config"
  ],
  "author": "bobbyhuang666",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^5.2.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "vitest": "^4.1.7"
  },
  "exports": {
    ".": "./index.js",
    "./sdk": "./sdk/index.js",
    "./domain": "./domain/index.js",
    "./domain/validate": "./domain/validateDomain.js",
    "./domain/registry": "./domain/DomainRegistry.js",
    "./store": "./store/index.js",
    "./config/defaults": "./config/defaults.js",
    "./presets/campus": "./presets/campus/index.js",
    "./presets/tavern": "./presets/tavern/index.js"
  },
  "types": "sdk/types.d.ts"
}
